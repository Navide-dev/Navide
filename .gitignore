# ─── Node / Electron ────────────────────────────────────────────────────────
node_modules
.registry-data/
.pnpm-store/
out/
dist/
release/
.vite/

# TypeScript incremental build info (generated, not source)
*.tsbuildinfo

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ─── Environment / Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python backend ─────────────────────────────────────────────────────────
backend/.venv/
**/__pycache__/
*.pyc
backend/dist/
build/pane-helper/
build/fn-key/
build/stt/
native/navide-stt/target/
native/navide-hello/target/
backend/build/
# ─── Electron packaging output ──────────────────────────────────────────────
dist-local/
dist-release/
dist-plugins/
dist-updatetest/
dist-test-fixtures/
backend/*.egg-info/
backend/.mypy_cache/
backend/.ruff_cache/
# Written next to the package at import by osplat's Windows askpass launcher
# (on Windows, and on any host running the suite with -p tests.osplat_win_swap).
backend/agent_team_backend/git_askpass_helper.cmd
# Note: backend/.python-version is intentionally tracked (uv uses it to pin Python)

# ─── macOS ──────────────────────────────────────────────────────────────────
.DS_Store

# ─── IDE / Editor ───────────────────────────────────────────────────────────
.idea/
.vscode/

# Cursor editor config (ignore contents), but keep plans/ for plan-driven workflow
.cursor/
!.cursor/plans/
!.cursor/plans/*.plan.md

# ─── Claude Code ────────────────────────────────────────────────────────────
.claude/

# ─── Agent-Team runtime data (per-workspace pipeline state) ────────────────
.agent-team/

# ─── Test artifacts ────────────────────────────────────────────────────────
test-results/
playwright-report/
.pytest_cache/
.playwright-mcp/
