{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "acme.commands",
  "name": "Commands",
  "version": "1.0.0",
  "publisher": "acme",
  "engines": {
    "navide": ">=0.2.36"
  },
  "permissions": {},
  "marketplace": {
    "description": "Declare commands.",
    "license": "MIT"
  },
  "contributes": {
    "views": [
      {
        "id": "main",
        "kind": "custom",
        "location": "window",
        "title": "Main",
        "entry": "frontend/index.html"
      }
    ],
    "commands": [
      {
        "id": "acme.commands.open",
        "title": "Open",
        "run": {
          "view": "main",
          "target": {
            "tab": "tests"
          }
        },
        "suggestedKey": "cmd+alt+t"
      },
      {
        "id": "acme.commands.runAll",
        "title": "Run all",
        "run": {
          "method": "tests.run"
        }
      }
    ]
  },
  "backend": {
    "entry": "backend/commands",
    "protocolVersion": 1,
    "activation": "startup",
    "methods": [
      "tests.run"
    ]
  }
}
