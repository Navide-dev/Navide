{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "acme.indexer",
  "name": "Indexer",
  "version": "1.0.0",
  "publisher": "acme",
  "permissions": {
    "system": [
      "fs"
    ]
  },
  "marketplace": {
    "description": "Reject backend methods empty.",
    "license": "MIT"
  },
  "contributes": {
    "views": [
      {
        "id": "left",
        "kind": "custom",
        "location": "left",
        "title": "Files",
        "entry": "frontend/left/index.html"
      }
    ]
  },
  "backend": {
    "entry": "backend/acme-indexer",
    "protocolVersion": 1,
    "activation": "startup",
    "methods": [],
    "events": [
      "files.indexProgress"
    ]
  }
}
