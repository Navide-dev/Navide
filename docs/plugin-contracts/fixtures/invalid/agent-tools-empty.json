{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "nerdtechnic.devmap",
  "name": "Dev Map",
  "version": "0.2.0",
  "publisher": "nerdtechnic",
  "permissions": {
    "system": [
      "fs"
    ]
  },
