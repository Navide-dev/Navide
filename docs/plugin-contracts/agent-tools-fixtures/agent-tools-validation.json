{
  "$comment": "validateAgentTools(manifest) returns every error, ordered by entry index and then by the check order in the contract doc, section 2.5. Only id, backend and contributes are read; a contributes.agentTools error carries list: \"contributes\".",
  "cases": [
    {
      "name": "valid read and write tools",
      "manifest": {
        "id": "nerdtechnic.devmap",
        "backend": {
          "entry": "bin/devmap",
          "protocolVersion": 1,
          "activation": "startup",
          "agentTools": [
            {
              "name": "devmap_read",
              "method": "devmap.read",
              "risk": "read",
              "title": "Read dev map",
              "description": "Read this workspace's dev map.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "devmap_set_status",
              "method": "devmap.block.status",
              "risk": "write",
              "title": "Read dev map",
              "description": "Read this workspace's dev map.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              },
              "timeoutMs": 120000
            }
          ],
          "methods": [
            "devmap.read",
            "devmap.block.status"
          ]
        }
      },
      "expectedErrors": []
    },
    {
      "name": "no agentTools at all is valid",
      "manifest": {
        "id": "nerdtechnic.devmap",
        "backend": {
          "entry": "bin/x",
          "protocolVersion": 1,
          "activation": "startup"
        }
      },
      "expectedErrors": []
    },
    {
      "name": "no backend at all is valid",
      "manifest": {
        "id": "nerdtechnic.devmap"
      },
      "expectedErrors": []
    },
    {
      "name": "agentTools is not an array",
      "manifest": {
        "id": "nerdtechnic.devmap",
        "backend": {
          "entry": "bin/devmap",
          "protocolVersion": 1,
          "activation": "startup",
          "agentTools": {
            "name": "devmap_read"
          },
          "methods": [
            "devmap.read",
            "devmap.block.status"
          ]
        }
      },
      "expectedErrors": [
        {
          "index": null,
          "field": "agentTools",
          "code": "AGENT_TOOLS_NOT_ARRAY"
        }
      ]
    },
    {
      "name": "an entry is not an object",
      "manifest": {
        "id": "nerdtechnic.devmap",
        "backend": {
          "entry": "bin/devmap",
          "protocolVersion": 1,
          "activation": "startup",
          "agentTools": [
            "devmap_read"
