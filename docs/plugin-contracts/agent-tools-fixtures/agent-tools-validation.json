          "methods": [
            "devmap.read",
            "devmap.block.status"
          ]
        }
      },
      "expectedErrors": [
        {
          "index": 0,
          "field": null,
          "code": "AGENT_TOOL_NOT_OBJECT"
        }
      ]
    },
    {
      "name": "unknown fields are refused, sorted",
      "manifest": {
        "id": "nerdtechnic.devmap",
        "backend": {
          "entry": "bin/devmap",
          "protocolVersion": 1,
