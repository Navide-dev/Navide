  ],
  "arrival": [
    {
      "name": "full pieces then a short last one",
      "chunkBytes": 8,
      "pieces": [
        "abcdefgh",
        "abcde",
        "ab"
      ],
      "expected": [
        {
          "ok": true,
          "short": false
        },
        {
          "ok": true,
          "short": false
        },
        {
          "ok": true,
          "short": true
        }
      ]
    },
    {
      "name": "any piece after a short one fails at once",
      "chunkBytes": 8,
      "pieces": [
        "a",
        "bcdefghi",
        "x"
      ],
      "expected": [
        {
          "ok": true,
          "short": true
        },
        {
          "ok": false,
          "code": "PLUGIN_TOOL_CHUNKS_INVALID",
          "reason": "short"
        }
      ]
    },
    {
      "name": "a one-byte drip fails on the second byte",
      "chunkBytes": 131072,
      "pieces": [
        "{",
        "\""
      ],
      "expected": [
        {
          "ok": true,
          "short": true
        },
        {
          "ok": false,
          "code": "PLUGIN_TOOL_CHUNKS_INVALID",
          "reason": "short"
        }
      ]
    },
    {
      "name": "a full piece may end early by up to 3 bytes for a code point",
      "chunkBytes": 8,
      "pieces": [
        "abcde",
        "😀"
      ],
      "expected": [
        {
          "ok": true,
          "short": false
        },
        {
          "ok": true,
          "short": true
        }
      ]
    },
    {
      "name": "a piece that is not a string",
      "chunkBytes": 8,
      "pieces": [
        "abcdefgh",
        null
      ],
      "expected": [
        {
          "ok": true,
          "short": false
        },
        {
          "ok": false,
          "code": "PLUGIN_TOOL_CHUNKS_INVALID",
          "reason": "seq"
        }
      ]
    },
    {
      "name": "a repeated seq fails at once",
      "chunkBytes": 8,
      "pieces": [
        "abcdefgh",
        "abcdefgh"
      ],
      "seqs": [
        0,
        0
      ],
      "expected": [
        {
          "ok": true,
          "short": false
        },
        {
          "ok": false,
          "code": "PLUGIN_TOOL_CHUNKS_INVALID",
          "reason": "seq"
        }
      ]
    },
    {
      "name": "a seq that steps back fails at once",
      "chunkBytes": 8,
      "pieces": [
        "abcdefgh",
        "abcdefgh",
        "abcdefgh"
      ],
      "seqs": [
        0,
        1,
        0
      ],
      "expected": [
        {
          "ok": true,
          "short": false
        },
        {
          "ok": true,
          "short": false
        },
        {
          "ok": false,
          "code": "PLUGIN_TOOL_CHUNKS_INVALID",
          "reason": "seq"
        }
      ]
    },
    {
      "name": "a seq that skips ahead fails at once",
      "chunkBytes": 8,
      "pieces": [
        "abcdefgh",
        "abcdefgh"
      ],
      "seqs": [
        0,
        2
      ],
      "expected": [
        {
          "ok": true,
          "short": false
        },
        {
          "ok": false,
          "code": "PLUGIN_TOOL_CHUNKS_INVALID",
          "reason": "seq"
        }
      ]
    },
    {
      "name": "seqs in order pass",
      "chunkBytes": 8,
      "pieces": [
        "abcdefgh",
        "abcdefgh",
        "x"
      ],
      "seqs": [
        0,
        1,
        2
      ],
      "expected": [
        {
          "ok": true,
          "short": false
        },
        {
          "ok": true,
          "short": false
        },
        {
          "ok": true,
          "short": true
        }
      ]
    }
  ]
}
