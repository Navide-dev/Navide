        "block_id": "b1",
        "n": 3
      },
      "canonical": true,
      "bytes": 39,
      "sha256": "60fad2036b1e8fc7fa056ab3460b7b3d9e1a0016df3738b0917b3495de6d350a"
    },
    {
      "name": "non-ASCII: hashed escaped, counted as sent",
      "arguments": {
        "note": "中文 😀"
      },
      "canonical": true,
      "bytes": 22,
      "sha256": "5d4f445760a46a7d0b8518e2dedc5ca39d780169d15ec23bb68b407f858b1147"
    },
    {
      "name": "Chinese counts 3 bytes per character",
      "arguments": {
        "q": "中文"
      },
      "canonical": true,
      "bytes": 14,
      "sha256": "8f29ca97d1cd7971078bd43ffe6af2bc4a259e46e65097137c29a6da54199d24"
    },
    {
      "name": "emoji counts 4 bytes",
      "arguments": {
        "q": "😀"
      },
      "canonical": true,
      "bytes": 12,
      "sha256": "f94aba3244d5714b72143b49c48965d38879d25882c33036cc25478dcc674a89"
    },
    {
      "name": "empty object",
      "arguments": {},
      "canonical": true,
      "bytes": 2,
      "sha256": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
