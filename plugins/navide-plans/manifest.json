{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "navide.plans",
  "name": "Plans",
  "version": "0.1.0",
  "publisher": "navide",
  "engines": { "navide": "^0.1.0" },
  "permissions": {
    "system": ["fs", "ui", "aiCli"],
    "scopes": {
      "fs": {
        "root": "repository",
        "read": [
          "**/.agent-team/plans/*",
          "**/.agent-team/reports/*",
          "**/.claude/loop-reports/*",
          "**/.claude/plans/*",
          "**/.cursor/plans/*",
          "**/docs/plans/*",
          "**/docs/reports/*",
          "**/.agent-team/plans/.history/**",
          "**/.agent-team/reports/.history/**",
          "**/.claude/loop-reports/.history/**",
          "**/.claude/plans/.history/**",
          "**/.cursor/plans/.history/**",
          "**/docs/plans/.history/**",
          "**/docs/reports/.history/**",
          ".plans/*"
        ],
        "write": [
          "**/.agent-team/plans/*",
          "**/.agent-team/reports/*",
          "**/.claude/loop-reports/*",
          "**/.claude/plans/*",
          "**/.cursor/plans/*",
          "**/docs/plans/*",
          "**/docs/reports/*",
          ".plans/*"
        ]
      }
    }
  },
  "marketplace": {
    "description": "Review and update workspace plans.",
    "license": "MIT",
    "repository": "https://github.com/Navide-dev/Navide",
    "categories": ["productivity", "project-management"]
  },
  "contributes": {
    "views": [
      {
        "id": "left",
        "kind": "custom",
        "location": "left",
        "title": "Plans",
        "entry": "frontend/left/index.html"
      },
      {
        "id": "window",
        "kind": "custom",
        "location": "window",
        "title": "Plans",
        "entry": "frontend/window/index.html"
      }
    ]
  },
  "backend": {
    "entry": "backend/navide-plans",
    "protocolVersion": 1,
    "activation": "startup"
  }
}
