{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "navide.mini-ide",
  "name": "Mini-IDE",
  "version": "0.1.0",
  "publisher": "navide",
  "engines": { "navide": "^0.1.0" },
  "permissions": { "system": ["fs", "ui", "aiCli"], "shell": "allowlist" },
  "marketplace": {
    "description": "Edit workspace files, review changes and run AI CLI sessions in an independent IDE window.",
    "license": "MIT",
    "repository": "https://github.com/Navide-dev/Navide",
    "categories": ["productivity", "development"]
  },
  "contributes": {
    "views": [{
      "id": "window",
      "kind": "custom",
      "location": "window",
      "title": "Mini-IDE",
      "entry": "frontend/window/index.html",
      "receives": {
        "protocolVersion": 1,
        "locations": ["left", "detail"],
        "editorTargets": { "protocolVersion": 1 },
        "closeGuard": { "protocolVersion": 1 }
      }
    }]
  }
}
