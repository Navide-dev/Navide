{
  "name": "acme-navide-files-example",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build --config vite.config.ts && node scripts/stage-package.mjs",
    "check": "navide-plugin validate dist/package",
    "package": "navide-plugin package dist/package --out dist/acme-files.vsix"
  },
  "dependencies": {
    "@navide/plugin-contracts": "^1.0.0",
    "@navide/plugin-sdk": "^1.0.0",
    "@navide/plugin-ui": "^1.0.0",
    "vue": "3.5.34",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^5.4.11"
  }
}
