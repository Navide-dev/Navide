{
  "name": "agent-team",
  "version": "0.2.19",
  "private": true,
  "author": "Navide Team",
  "description": "Navide: the AI-native engineering environment for one engineer directing multiple coding agents",
  "desktopName": "navide.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Navide-dev/Navide.git"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "pnpm run build:public-packages && vite build --config vite.plans.config.ts && pnpm run build:mini-ide:v2 && pnpm run build:plans:v2 && node scripts/build-plans-v2-backend.mjs --if-needed && pnpm run build:git:v2 && node scripts/stage-official-plugin-artifacts.mjs && node scripts/build-fn-key-helper.mjs --if-needed && electron-vite dev",
    "build": "pnpm run build:official-plugins && pnpm run build:git:legacy && pnpm run build:pane-helper && pnpm run build:fn-key && electron-vite build",
    "build:pane-helper": "node scripts/build-pane-helper.mjs",
    "build:fn-key": "node scripts/build-fn-key-helper.mjs",
    "build:stt": "node scripts/build-stt.mjs",
    "build:official-plugins": "pnpm run build:public-packages && pnpm run build:mini-ide && pnpm run build:mini-ide:v2 && pnpm run build:plans && pnpm run build:git:v2 && node scripts/stage-official-plugin-artifacts.mjs",
    "build:mini-ide": "vite build --config vite.mini-ide.config.ts",
    "build:mini-ide:v2": "vite build --config plugins/navide-mini-ide/vite.config.ts",
    "build:plans:legacy": "vite build --config vite.plans.config.ts",
    "build:plans:v2": "vite build --config plugins/navide-plans/vite.config.ts",
    "build:plans:backend": "node scripts/build-plans-v2-backend.mjs",
    "build:plans": "pnpm run build:plans:legacy && pnpm run build:plans:v2 && pnpm run build:plans:backend",
    "build:plans:fixture": "node scripts/build-plans-backend.mjs",
    "test:packaged-plans": "node scripts/run-artifact-tests.mjs --packaged-plans",
    "build:git:legacy": "vite build --config vite.git.config.ts",
    "build:git:v2": "vite build --config plugins/navide-git/vite.config.ts",
    "build:git": "pnpm run build:git:legacy && pnpm run build:git:v2",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:public": "tsc --noEmit -p packages/plugin-contracts/tsconfig.json && tsc --noEmit -p packages/plugin-sdk/tsconfig.json && vue-tsc --noEmit -p packages/plugin-ui/tsconfig.json",
    "typecheck:plugin-git": "pnpm run build:public-packages && vue-tsc --noEmit -p plugins/navide-git/tsconfig.json",
    "typecheck:plugin-plans": "pnpm run build:public-packages && vue-tsc --noEmit -p plugins/navide-plans/tsconfig.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:integration && pnpm run build:public-packages && vue-tsc --noEmit -p plugins/navide-git/tsconfig.json && vue-tsc --noEmit -p plugins/navide-plans/tsconfig.json && vue-tsc --noEmit -p plugins/navide-mini-ide/tsconfig.json && pnpm run typecheck:web && pnpm run typecheck:public",
    "build:public-packages": "tsc -p packages/plugin-contracts/tsconfig.json && tsc -p packages/plugin-sdk/tsconfig.build.json && vite build --config packages/plugin-ui/vite.config.ts && vue-tsc -p packages/plugin-ui/tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "backend:dev": "uv --project backend run python -m agent_team_backend",
    "package:local": "bash ./build.sh",
    "dist": "pnpm build && electron-builder",
    "release:check": "node scripts/verify-release-version.mjs",
    "release:prepare": "bash ./release.sh",
    "test:frontend": "vitest run --project unit --project cli",
    "test:artifacts": "vitest run --project artifacts",
    "test:artifacts:ci": "node scripts/run-artifact-tests.mjs --prepared",
    "test:infrastructure": "vitest run --project unit tests/infrastructure",
    "test:cli": "node scripts/run-cli-tests.mjs",
    "test:cli:frontend": "node scripts/run-cli-tests.mjs --frontend-only",
    "typecheck:plugin-mini-ide": "pnpm run build:public-packages && vue-tsc --noEmit -p plugins/navide-mini-ide/tsconfig.json"
  },
  "build": {
    "appId": "com.nerdtechnic.agent-team",
    "productName": "Navide",
    "directories": {
      "output": "dist-release"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "files": [
      "out/**/*",
      "!node_modules/{monaco-editor,mermaid,@xterm}/**"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      },
      {
        "from": "dist-plugins/mini-ide",
        "to": "plugins/mini-ide"
      },
      {
        "from": "dist-plugins/official-artifacts/factory-resources",
        "to": "official-artifacts"
      },
      {
        "from": "dist-plugins/plans",
        "to": "plugins/plans"
      },
      {
        "from": "dist-plugins/git",
        "to": "plugins/git"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Navide-dev",
        "repo": "Navide",
        "releaseType": "release"
      }
    ],
    "artifactName": "Navide-${version}-${arch}.${ext}",
    "protocols": [
      {
        "name": "Navide",
        "schemes": [
          "navide"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ],
        "NSMicrophoneUsageDescription": "Navide uses the microphone for push-to-talk voice input. Speech is transcribed locally on this Mac and is never uploaded."
      },
      "extraResources": [
        {
          "from": "backend/dist/agent_team_backend",
          "to": "bin/agent_team_backend"
        },
        {
          "from": "build/pane-helper/Navide Pane.app",
          "to": "bin/Navide Pane.app"
        },
        {
          "from": "build/fn-key",
          "to": "bin",
          "filter": [
            "navide-fn-key"
          ]
        },
        {
          "from": "build/stt",
          "to": "bin",
          "filter": [
            "navide-stt"
          ]
        }
      ]
    },
    "beforePack": "./scripts/dmg-hide-support-files.mjs",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "backend/dist/agent_team_backend.exe",
          "to": "bin/agent_team_backend.exe"
        },
        {
          "from": "build/stt",
          "to": "bin",
          "filter": [
            "navide-stt.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Navide",
      "artifactName": "Navide-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "navide",
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "Navide Team <nt.fitproject@gmail.com>",
      "synopsis": "AI-native engineering environment for directing multiple coding agents",
      "description": "Navide is a desktop engineering environment for one engineer directing multiple coding agent CLIs.",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "backend/dist/agent_team_backend",
          "to": "bin/agent_team_backend"
        },
        {
          "from": "build/stt",
          "to": "bin",
          "filter": [
            "navide-stt"
          ]
        }
      ]
    },
    "deb": {
      "packageName": "navide"
    }
  },
  "devDependencies": {
    "@navide/plugin-contracts": "link:packages/plugin-contracts",
    "@navide/plugin-sdk": "link:packages/plugin-sdk",
    "@navide/plugin-ui": "link:packages/plugin-ui",
    "@playwright/test": "^1.62.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^3.1.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.43",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    },
    "overrides": {
      "tar": "^7.5.19",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@>=3": "^5.0.12",
      "fast-uri": "^3.1.8",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "ip-address": "^10.3.1",
      "postcss": "^8.5.23",
      "form-data@4": "^4.0.6",
      "dompurify": "^3.4.16",
      "source-map-js": "^1.2.2",
      "katex": "^0.18.2",
      "tinypool": "^2.1.2",
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "html-to-text": "^10",
    "koffi": "^3.3.2",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.55.1",
    "vue-i18n": "11",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
