`;

exports[`AgentHistoryModal — entries of an embedded panel > renders a window-pane entry exactly as before 2`] = `
"<div data-v-0fb37e62="" class="history-detail"><div data-v-0fb37e62="" class="detail-title-row"><span data-v-0fb37e62="" class="ah-badge detail-name" data-truncate="">Claude</span><button data-v-0fb37e62="" class="ah-icon-btn" title="action.rename">✎</button><button data-v-0fb37e62="" class="ah-icon-btn ah-star-btn" title="action.star">☆</button><span data-v-0fb37e62="" class="ah-status removed">label.history-filter-removed</span></div><div data-v-0fb37e62="" class="detail-grid"><span data-v-0fb37e62="" class="detail-label">label.history-detail-agent</span><span data-v-0fb37e62="" class="detail-value">Claude Code (Anthropic)</span><span data-v-0fb37e62="" class="detail-label">label.history-detail-role</span><span data-v-0fb37e62="" class="detail-value">Dev</span><span data-v-0fb37e62="" class="detail-label">label.history-detail-origin</span><span data-v-0fb37e62="" class="detail-value">label.history-filter-manual</span><span data-v-0fb37e62="" class="detail-label">label.history-detail-spawned</span><span data-v-0fb37e62="" class="detail-value">{spawnedAt}</span><span data-v-0fb37e62="" class="detail-label">label.history-detail-removed</span><span data-v-0fb37e62="" class="detail-value">{removedAt}</span><span data-v-0fb37e62="" class="detail-label">label.history-detail-session</span><span data-v-0fb37e62="" class="detail-value detail-session">sess-1 <button data-v-0fb37e62="" class="ah-icon-btn" title="action.copy">⧉</button></span><span data-v-0fb37e62="" class="detail-label">label.history-detail-workspace</span><span data-v-0fb37e62="" class="detail-value detail-path">/ws</span></div><div data-v-0fb37e62="" class="agent-history-actions"><button data-v-0fb37e62="" class="ah-revive">action.resume-session</button><button data-v-0fb37e62="" class="ah-revive ah-preview">action.open-full-log</button><!-- Deletes the record *and* its CLI transcript log; active
                     entries never show it (their pane keeps running, so
                     deleting the record is ambiguous). --><button data-v-0fb37e62="" class="ah-revive ah-delete">action.delete</button></div><!-- Phase F: inline log preview (independent scroll region) --><div data-v-0fb37e62="" class="ah-log-preview"><div data-v-0fb37e62="" class="ah-log-toolbar"><div data-v-0fb37e62="" class="ah-log-search"><input data-v-0fb37e62="" class="ah-log-search-input" placeholder="label.log-search-placeholder" disabled=""><button data-v-0fb37e62="" class="ah-icon-btn" disabled="" title="action.prev-match">↑</button><button data-v-0fb37e62="" class="ah-icon-btn" disabled="" title="action.next-match">↓</button></div><button data-v-0fb37e62="" class="ah-icon-btn ah-log-copy" disabled="">action.copy-log</button></div><div data-v-0fb37e62="" class="ah-log-body"><div data-v-0fb37e62="" class="ah-log-empty">label.history-log-none</div></div></div></div>"
`;

