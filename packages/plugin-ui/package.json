{
  "name": "@navide/plugin-ui",
  "version": "1.0.0",
  "description": "Vue components, controllers, shared UI primitives, and tokens for Navide plugins.",
  "license": "MIT",
  "keywords": ["navide", "plugin", "ui", "vue"],
  "homepage": "https://github.com/Navide-dev/Navide/blob/main/docs/en-US/build-for-navide.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Navide-dev/Navide.git",
    "directory": "packages/plugin-ui"
  },
  "bugs": "https://github.com/Navide-dev/Navide/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation/index.d.ts",
      "import": "./dist/foundation/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./file-picker": {
      "types": "./dist/terminalFilePicker.d.ts",
      "import": "./dist/file-picker.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    }
  },
  "peerDependencies": {
    "monaco-editor": "^0.55.1",
    "@navide/plugin-sdk": "^1.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": { "optional": true }
  },
  "devDependencies": {
    "monaco-editor": "^0.55.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "^6.0.0",
    "@navide/plugin-sdk": "^1.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5 || ^11.0.0"
  }
}
