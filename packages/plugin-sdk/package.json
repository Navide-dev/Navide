{
  "name": "@navide/plugin-sdk",
  "version": "1.0.0",
  "description": "Framework-neutral activation and capability-call SDK for Navide plugins.",
  "license": "MIT",
  "keywords": ["navide", "plugin", "sdk", "cli"],
  "homepage": "https://github.com/Navide-dev/Navide/blob/main/docs/en-US/build-for-navide.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Navide-dev/Navide.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": "https://github.com/Navide-dev/Navide/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "navide-plugin": "bin/navide-plugin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "peerDependencies": {
    "@navide/plugin-contracts": "^1.0.0"
  },
  "devDependencies": {
    "@navide/plugin-contracts": "1.0.0"
  }
}
