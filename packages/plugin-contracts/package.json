{
  "name": "@navide/plugin-contracts",
  "version": "1.0.0",
  "description": "Public manifest, capability, error, and schema contracts for Navide plugins.",
  "license": "MIT",
  "keywords": ["navide", "plugin", "manifest", "contracts", "json-schema"],
  "homepage": "https://github.com/Navide-dev/Navide/blob/main/docs/en-US/build-for-navide.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Navide-dev/Navide.git",
    "directory": "packages/plugin-contracts"
  },
  "bugs": "https://github.com/Navide-dev/Navide/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas/plugin-manifest-v2.schema.json": "./dist/schemas/plugin-manifest-v2.schema.json",
    "./schemas/capabilities-v1.json": "./dist/schemas/capabilities-v1.json",
    "./schemas/execution-policy-v1.schema.json": "./dist/schemas/execution-policy-v1.schema.json"
  }
}
