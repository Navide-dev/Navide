{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navide.dev/schemas/plugin-manifest-v2.schema.json",
  "title": "Navide Plugin Manifest v2 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apiVersion", "id", "name", "version", "publisher", "permissions", "marketplace"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "apiVersion": { "type": "string", "pattern": "^[~^]?[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n<>]+$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "publisher": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["navide"],
      "properties": {
        "navide": {
          "type": "string",
          "minLength": 1,
          "description": "Lowest Navide release the package supports. ^X.Y.Z, ~X.Y.Z, >=X.Y.Z and a bare X.Y.Z all mean X.Y.Z or newer (no upper bound is enforced); * means any release. Any other form is treated as unknown and does not block installation."
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["fs", "ui", "aiCli", "web", "agents", "agentMessages"] },
          "if": { "contains": { "const": "agentMessages" } },
          "then": { "contains": { "const": "agents" } }
        },
        "shell": { "enum": ["allowlist", "full"] },
        "scopes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fs"],
          "description": "Declared resource scopes. Disclosure only: the Host shows them to the user and neither grants nor enforces anything from them.",
          "properties": {
            "fs": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [{ "required": ["read"] }, { "required": ["write"] }],
              "properties": {
                "root": {
                  "enum": ["workspace", "repository"],
                  "description": "What the patterns are relative to: the workspace (default) or the nearest enclosing Git repository root."
                },
                "read": { "$ref": "#/$defs/scopePaths" },
                "write": { "$ref": "#/$defs/scopePaths" }
              }
            }
          }
        }
      }
    },
    "marketplace": { "$ref": "#/$defs/marketplace" },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["views"],
      "properties": {
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/view" }
        }
      }
    },
    "backend": { "$ref": "#/$defs/backend" },
    "extensionPack": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
      "description": "Extension Pack member ids. A pack declares no contributes, backend or permissions; each member is installed, verified and confirmed on its own, and a member may not itself be a pack."
    }
  },
  "anyOf": [
    { "required": ["contributes"] },
    { "required": ["backend"] },
    { "required": ["extensionPack"] }
  ],
  "if": { "required": ["extensionPack"] },
  "then": {
    "not": { "anyOf": [{ "required": ["contributes"] }, { "required": ["backend"] }] },
    "properties": { "permissions": { "maxProperties": 0 } }
  },
  "$defs": {
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "license"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "pattern": "^[^\\r\\n<>]+$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.()+ -]*$"
        },
        "repository": { "$ref": "#/$defs/httpsUri" },
        "homepage": { "$ref": "#/$defs/httpsUri" },
        "categories": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }
        },
        "icon": { "$ref": "#/$defs/safePath" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "location", "title", "entry"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "const": "custom" },
        "location": { "enum": ["top", "bottom", "right", "left", "main", "window", "detail"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n<>]+$" },
        "icon": { "$ref": "#/$defs/safePath" },
        "entry": { "$ref": "#/$defs/htmlPath" },
        "detailView": { "$ref": "#/$defs/viewId" },
        "targetSchema": { "$ref": "#/$defs/jsonPath" },
        "receives": { "$ref": "#/$defs/receives" }
      },
      "allOf": [
        { "if": { "required": ["detailView"] }, "then": { "properties": { "location": { "const": "left" } } } },
        { "if": { "required": ["targetSchema"] }, "then": { "properties": { "location": { "const": "detail" } } } },
        { "if": { "required": ["receives"] }, "then": { "properties": { "location": { "const": "window" } } } }
      ]
    },
    "receives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "locations"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["left", "detail"] }
        },
        "editorTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion"],
          "properties": { "protocolVersion": { "const": 1 } }
        },
        "closeGuard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion"],
          "properties": { "protocolVersion": { "const": 1 } }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "protocolVersion", "activation"],
      "properties": {
        "entry": { "$ref": "#/$defs/backendEntry" },
        "protocolVersion": {
          "const": 1,
          "description": "Navide Backend Wire v1, aligned with MCP revision 2026-07-28 base message and stdio conventions."
        },
        "activation": { "const": "startup" },
        "methods": { "$ref": "#/$defs/backendNames", "maxItems": 64 },
        "events": { "$ref": "#/$defs/backendNames", "maxItems": 32 },
        "agentTools": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/agentTool" },
          "description": "Tools an agent may call through the core navide MCP server once the user consents. Rules this schema cannot express (name prefix derived from the id, reserved names, method listed in methods, unique names, integers only in inputSchema, the 1 MiB stability cap) are checked by validateAgentTools; see docs/en-US/plugin-agent-tools-contract.md."
        }
      }
    },
    "agentTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "method", "risk", "title", "description", "inputSchema"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,15}_[a-z0-9_]{1,40}$" },
        "method": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
        "risk": { "enum": ["read", "write"] },
        "title": { "$ref": "#/$defs/agentToolText" },
        "description": { "$ref": "#/$defs/agentToolText" },
        "inputSchema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000, "default": 30000 }
      }
    },
    "agentToolText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029<>]+$"
    },
    "backendNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$" },
      "description": "Package-local backend method or event names. The Host forwards only declared names."
    },
    "viewId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "scopePaths": {
      "description": "Relative path patterns. * matches within one segment, ** (a whole segment) matches zero or more segments; a pattern covers only the paths it matches.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\/$)(?!.*(?:[^/]\\*\\*|\\*\\*[^/]))[A-Za-z0-9._*/-]+$"
      }
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._/-]+$"
    },
    "jsonPath": {
      "allOf": [
        { "$ref": "#/$defs/safePath" },
        { "pattern": "^[A-Za-z0-9._/-]+\\.json$" }
      ]
    },
    "backendEntry": {
      "description": "Manifest-level rejection of recognizable source/script filenames. Target executable verification belongs to package validation.",
      "allOf": [
        { "$ref": "#/$defs/safePath" },
        {
          "pattern": "^(?!.*\\.(?:[Pp][Yy][Ww]?|[Jj][Ss]|[Mm][Jj][Ss]|[Cc][Jj][Ss]|[Tt][Ss]|[Tt][Ss][Xx]|[Ss][Hh]|[Bb][Aa][Ss][Hh]|[Zz][Ss][Hh]|[Ff][Ii][Ss][Hh]|[Pp][Ss]1|[Cc][Mm][Dd]|[Bb][Aa][Tt])$).+$"
        }
      ]
    },
    "htmlPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+\\.html$"
    },
    "httpsUri": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    }
  }
}
